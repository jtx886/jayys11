<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="设置"
        android:textColor="@color/tx"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="30dp">

            <!-- TMDB Key -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:text="TMDB API Key（必填，浏览和搜索影视需要）"
                android:textColor="@color/tx2"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/setKey"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/btn_ghost"
                android:hint="粘贴 themoviedb.org 的 API Key"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/tx"
                android:textColorHint="#525b6e"
                android:textSize="13.5sp" />

            <Button
                android:id="@+id/btnSaveKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="保存并测试"
                android:textColor="#ffffff"
                android:textStyle="bold" />

            <!-- 播放源 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="24dp"
                android:paddingBottom="10dp"
                android:text="播放源（苹果CMS JSON 接口）"
                android:textColor="@color/tx2"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/srcList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnAddSrc"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_ghost"
                android:text="添加播放源"
                android:textColor="@color/tx"
                android:textStyle="bold" />

            <!-- 说明 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingExtra="5dp"
                android:text="说明：本 App 为独立应用，收藏与观看历史保存在手机本地，无需服务器与数据库。播放资源来自第三方接口，仅供学习交流。"
                android:textColor="@color/mut"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
