<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部：返回 + 背景图 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="236dp">

            <ImageView
                android:id="@+id/dBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.42"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/grad_backdrop" />

            <TextView
                android:id="@+id/dBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="‹ 返回"
                android:textColor="@color/tx"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 海报 + 信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-84dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/dPoster"
                android:layout_width="116dp"
                android:layout_height="168dp"
                android:background="@drawable/ph_poster"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="90dp">

                <TextView
                    android:id="@+id/dTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tx"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:textColor="@color/mut"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/dMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textColor="@color/tx2"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/dOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:padding="16dp"
            android:textColor="@color/tx2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dCast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/mut"
            android:textSize="12sp" />

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp">

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="立即播放"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFav"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/btn_ghost"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="收藏"
                android:textColor="@color/tx"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- 选择季 -->
        <LinearLayout
            android:id="@+id/seasonSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="22dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="选择季"
                android:textColor="@color/tx"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.jay.movie.ui.FlowLayout
                android:id="@+id/seasonFlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 播放源 -->
        <LinearLayout
            android:id="@+id/srcSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="播放源"
                android:textColor="@color/tx"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.jay.movie.ui.FlowLayout
                android:id="@+id/srcFlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 音轨 -->
        <LinearLayout
            android:id="@+id/trackSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="音轨"
                android:textColor="@color/tx"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.jay.movie.ui.FlowLayout
                android:id="@+id/trackFlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 剧集列表 -->
        <LinearLayout
            android:id="@+id/epSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/epLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="剧集"
                android:textColor="@color/tx"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.jay.movie.ui.FlowLayout
                android:id="@+id/epFlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/dStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="30dp"
            android:text="加载中…"
            android:textColor="@color/mut"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />
    </LinearLayout>
</ScrollView>
