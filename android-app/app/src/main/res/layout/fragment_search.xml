<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="搜索"
        android:textColor="@color/tx"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/sInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:hint="搜索影视 / 剧集 / 综艺"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/tx"
            android:textColorHint="#525b6e"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/sBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_primary"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="搜索"
            android:textColor="#ffffff"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/sStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="30dp"
        android:text="输入关键词开始搜索"
        android:textColor="@color/mut"
        android:textSize="13sp" />

    <GridView
        android:id="@+id/sGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:columnWidth="106dp"
        android:horizontalSpacing="10dp"
        android:numColumns="auto_fit"
        android:padding="10dp"
        android:scrollbars="none"
        android:stretchMode="spacingWidth"
        android:verticalSpacing="12dp" />
</LinearLayout>
