<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"
            android:text="‹"
            android:textColor="@color/tx"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/tx"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="14dp"
            android:textColor="@color/mut"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 播放器 -->
    <FrameLayout
        android:id="@+id/playerWrap"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="#000000">

        <WebView
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/pLoad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="正在解析播放地址…"
            android:textColor="@color/tx2"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- 下方信息 + 剧集 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/pInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/tx2"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <Button
                    android:id="@+id/btnPrev"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="上一集"
                    android:textColor="@color/tx"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="下一集"
                    android:textColor="@color/tx"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="换源重试"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 换源选择 -->
            <LinearLayout
                android:id="@+id/srcSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="切换播放源"
                    android:textColor="@color/tx"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <com.jay.movie.ui.FlowLayout
                    android:id="@+id/srcFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 剧集 -->
            <LinearLayout
                android:id="@+id/epSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/epLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="选集"
                    android:textColor="@color/tx"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <com.jay.movie.ui.FlowLayout
                    android:id="@+id/epFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
