<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="14dp"
        android:text="添加播放源"
        android:textColor="@color/tx"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/srcName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_ghost"
        android:hint="源名称（如：备用资源站）"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/tx"
        android:textColorHint="#525b6e"
        android:textSize="13.5sp" />

    <EditText
        android:id="@+id/srcUrl"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_ghost"
        android:hint="接口地址 https://…/api.php"
        android:inputType="textUri"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/tx"
        android:textColorHint="#525b6e"
        android:textSize="13.5sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="格式：苹果CMS V10 JSON 采集接口（接口需支持 ac=videolist 参数）"
        android:textColor="@color/mut"
        android:textSize="11.5sp" />
</LinearLayout>
