<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/btn_ghost"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tx"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowDef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="默认"
            android:textColor="@color/ok"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/rowDel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@null"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="删除"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingTop="4dp"
        android:singleLine="true"
        android:textColor="@color/mut"
        android:textSize="11.5sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="点击整行可设为默认源"
        android:textColor="#525b6e"
        android:textSize="10.5sp" />
</LinearLayout>
